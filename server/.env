# env template to fill if the module wants to be used (of course the deployment names can be changed, but think of changing it in the code as well then). 

# Embeddings Poland Central
AZURE_OPENAI_API_KEY_EMBEDDING_POLAND=
AZURE_OPENAI_ENDPOINT_POLAND=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Chat Germany-West
AZURE_OPENAI_API_KEY_GERMANY=
AZURE_OPENAI_ENDPOINT_GERMANY=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
